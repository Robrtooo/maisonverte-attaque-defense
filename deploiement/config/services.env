# deploiement/config/services.env
#
# Canonical inventory of MaisonVerte containers, stable Compose project
# names and Vulhub scenario paths for E2-E16, mirroring the service table in
# ARCHITECTURE.md. E1 (OPNsense) is configured manually and is not listed
# here. E<n>_VULHUB_PATH is empty for the sane services (E4, E15, E16),
# which are not derived from a Vulhub scenario.

E2_CONTAINER=cache-dmz01
E2_PROJECT=mv-e2
E2_ZONE=DMZ
E2_LEVEL=N1
E2_VULHUB_PATH=nginx/insecure-configuration

E3_CONTAINER=shop-dmz01
E3_PROJECT=mv-e3
E3_ZONE=DMZ
E3_LEVEL=N1
E3_VULHUB_PATH=wordpress/pwnscriptum

E4_CONTAINER=mobile-dmz01
E4_PROJECT=mv-e4
E4_ZONE=DMZ
E4_LEVEL=sain
E4_VULHUB_PATH=

E5_CONTAINER=market-dmz01
E5_PROJECT=mv-e5
E5_ZONE=DMZ
E5_LEVEL=N1
E5_VULHUB_PATH=tomcat/CVE-2017-12615

E6_CONTAINER=backoffice-srv01
E6_PROJECT=mv-e6
E6_ZONE=SRV
E6_LEVEL=N2
E6_VULHUB_PATH=ofbiz/CVE-2023-51467

E7_CONTAINER=search-srv01
E7_PROJECT=mv-e7
E7_ZONE=SRV
E7_LEVEL=N2
E7_VULHUB_PATH=elasticsearch/CVE-2015-1427

E8_CONTAINER=cache-srv01
E8_PROJECT=mv-e8
E8_ZONE=SRV
E8_LEVEL=N2
E8_VULHUB_PATH=redis/4-unacc

E9_CONTAINER=files-srv01
E9_PROJECT=mv-e9
E9_ZONE=SRV
E9_LEVEL=N2
E9_VULHUB_PATH=samba/CVE-2017-7494

E10_CONTAINER=catalog-data01
E10_PROJECT=mv-e10
E10_ZONE=DATA
E10_LEVEL=N3
E10_VULHUB_PATH=postgres/CVE-2019-9193

E11_CONTAINER=clients-data01
E11_PROJECT=mv-e11
E11_ZONE=DATA
E11_LEVEL=N3
E11_VULHUB_PATH=mongo-express/CVE-2019-10758

E12_CONTAINER=pos-consol-shops01
E12_PROJECT=mv-e12
E12_ZONE=SHOPS
E12_LEVEL=N3
E12_VULHUB_PATH=xxl-job/unacc

E13_CONTAINER=wms-shops01
E13_PROJECT=mv-e13
E13_ZONE=SHOPS
E13_LEVEL=N3
E13_VULHUB_PATH=struts2/s2-045

E14_CONTAINER=deploy-srv01
E14_PROJECT=mv-e14
E14_ZONE=SRV
E14_LEVEL=N2
E14_VULHUB_PATH=jenkins/CVE-2024-23897

E15_CONTAINER=supervision-admin01
E15_PROJECT=mv-e15
E15_ZONE=ADMIN
E15_LEVEL=sain
E15_VULHUB_PATH=

E16_CONTAINER=crm-srv01
E16_PROJECT=mv-e16
E16_ZONE=SRV
E16_LEVEL=sain
E16_VULHUB_PATH=

ELK_PROJECT=mv-elk
ELK_ES_CONTAINER=elk-admin01-es
ELK_KIBANA_CONTAINER=elk-admin01-kibana
ELK_FILEBEAT_CONTAINER=elk-admin01-filebeat
ELK_ZONE=ADMIN
ELK_LEVEL=defense
