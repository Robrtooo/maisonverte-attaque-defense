# deploiement/config/networks.env
#
# Docker network constants for the MaisonVerte lab. Loaded via
# lib/common.sh:mv_load_env. Six externally created zone networks (one per
# logical zone from ARCHITECTURE.md) plus nine internal micro-segments that
# enforce chains A, B and C. Micro-segments are never published on the host.

# --- Zone networks ------------------------------------------------------

NET_DMZ_NAME=net-dmz
NET_DMZ_SUBNET=172.30.10.0/24

NET_SRV_NAME=net-srv
NET_SRV_SUBNET=172.30.20.0/24

NET_DATA_NAME=net-data
NET_DATA_SUBNET=172.30.30.0/24

NET_USERS_NAME=net-users
NET_USERS_SUBNET=172.30.40.0/24

NET_ADMIN_NAME=net-admin
NET_ADMIN_SUBNET=172.30.50.0/24

NET_SHOPS_NAME=net-spec
NET_SHOPS_SUBNET=172.30.60.0/24

# --- Chain A micro-segments (E2-E7, E7-E8, E8-E10) --------------------------

NET_A_EDGE_NAME=mv-a-edge
NET_A_CORE_NAME=mv-a-core
NET_A_DATA_NAME=mv-a-data

# --- Chain B micro-segments (E5-E14, E14-E12, E12-E11) ----------------------

NET_B_EDGE_NAME=mv-b-edge
NET_B_CORE_NAME=mv-b-core
NET_B_DATA_NAME=mv-b-data

# --- Chain C micro-segments (E3-E6, E6-E9, E9-E13) --------------------------

NET_C_EDGE_NAME=mv-c-edge
NET_C_CORE_NAME=mv-c-core
NET_C_SPEC_NAME=mv-c-spec
