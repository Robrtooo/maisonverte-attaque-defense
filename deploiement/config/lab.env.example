# deploiement/config/lab.env.example
#
# Copy this file to deploiement/config/lab.env for host-specific overrides.
# lab.env is optional: scripts only load it when present (via
# lib/common.sh:mv_load_env), it is never committed (see .gitignore), and it
# must never contain a flag value or other secret — those come exclusively
# from enonce/flags-G04.csv and deploiement/state/secrets/.
#
# Uncomment and adjust only what this specific lab host needs; leave
# everything else commented to keep the defaults from networks.env and
# services.env.

# MV_PROJECT_PREFIX=maisonverte
# MV_LOG_LEVEL=info
